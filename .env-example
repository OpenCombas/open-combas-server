COMBAS_IP=127.0.0.1
MONGO_USER=opencombas
MONGO_PASSWORD=opencombas
HOSTNAME=test.example.org
TURN_KEY_ID=xxxxxxxxxxxxxxx
TURN_API_TOKEN=xxxxxxxxxxxxxxxx

# Promtail -> shared Loki (container-log shipping). LOKI_PUSH_URL is the monitoring edge's push route;
# ENVIRONMENT tags this deployment (production or testenv); LOKI_USERNAME/PASSWORD are the /loki basic_auth.
LOKI_PUSH_URL=https://<monitoring-host>/loki/api/v1/push
ENVIRONMENT=testenv
LOKI_USERNAME=promtail
LOKI_PASSWORD=xxxxxxxxxxxxxxxx